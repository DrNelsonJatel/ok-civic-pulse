# ---------------------------------------------------------------------------
# NEVER COMMIT COMMENT TEXT.
#
# Castanet's ToU prohibits redistribution, and council minutes name real
# residents. Comment text and speaker names live ONLY in the local DuckDB.
# Everything below either contains that text or is regenerable output.
#
# NOTE: gitignore has no trailing-comment syntax. A line like "db/  # text"
# is treated as a literal pattern and silently matches nothing.
# ---------------------------------------------------------------------------

# civic_pulse.duckdb holds comment text; serve.duckdb is derived
db/

# Batch API metadata: classify_batch_submit() saves the submitted chunks,
# which INCLUDE body_local. Least obvious text leak in the repo.
output/batch_*.rds

# Local run state: the id of the last submitted Message Batch. Regenerable,
# machine-specific, and leaving it unignored makes `output/` show up as
# untracked, which invites an `git add output/` that would sweep in the
# batch_*.rds text above.
output/last_batch_id.txt

output/cache/
output/logs/
output/weekly/
output/py_local/
output/reports/
output/snapshots/

# Quarto / render intermediates
report/daily.pdf
report/daily.typ
report/preview.png
report/daily_files/
dashboard/.quarto/
dashboard/index_files/
.quarto/

# Credentials and local state
.env
.Renviron
credentials.sqlite
*.rds.local

# R / macOS
.Rproj.user
.Rhistory
.RData
.Rapp.history
renv/library/
.DS_Store
